# ─── Repositório de DADOS (PDLSetlist) ───────────────────────────────────────
# NÃO confundir com o repo do app (PDL-Setlist-App)
VITE_GITHUB_OWNER=FelipeNovais89
VITE_GITHUB_DATA_REPO=PDLSetlist         # repo dos dados, não do app!
VITE_GITHUB_BRANCH=main
VITE_GITHUB_SETLISTS_DIR=Data/setlists   # case-sensitive: 's' minúsculo
VITE_SONGS_CSV_URL=https://raw.githubusercontent.com/FelipeNovais89/PDLSetlist/refs/heads/main/Data/PDL_musicas.csv

# ─── GitHub Personal Access Token (escopo: repo) ──────────────────────────────
VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Gemini AI (OCR de cifras) ────────────────────────────────────────────────
VITE_GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Google Drive — service account (configurar no Vercel, NÃO no .env local) ─
# Obtenha o JSON da service account no Google Cloud Console:
#   IAM & Admin → Service Accounts → Create → Add Key → JSON
#
# GOOGLE_SERVICE_ACCOUNT_EMAIL    = campo "client_email" do JSON
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY = campo "private_key" do JSON
#   (cole o valor completo incluindo -----BEGIN/END PRIVATE KEY-----)
#
# No Vercel: Settings → Environment Variables → adicione as duas abaixo:
GOOGLE_SERVICE_ACCOUNT_EMAIL=sua-conta@projeto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
